<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <AssemblyName>LinkTestServerGui</AssemblyName>
    <RootNamespace>LinkTest.ServerGui</RootNamespace>
    <ApplicationIcon>..\LinkTest.Server\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinkTest.Core\LinkTest.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared WinForms help UI (ⓘ explanations) -->
    <Compile Include="..\LinkTest.Client\HelpUi.cs" Link="HelpUi.cs" />
  </ItemGroup>

</Project>
