<Project Sdk="Microsoft.NET.Sdk">

  <!-- Browser test: web page + WebSocket / WebRTC test endpoints hosted next to the LinkTest server. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LinkTest.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinkTest.Core\LinkTest.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The web page is served from the assembly (no files next to the exe). -->
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DataChannelDotnet" Version="1.3.1" />
  </ItemGroup>

</Project>
